# ==============================================================================
# XEROX CYBERSECURITY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values before running.
# Never commit .env files containing production secrets to version control.
# ==============================================================================

# --- Runtime Environment ---
ENVIRONMENT=production
PORT=8000

# --- PostgreSQL Database Configuration ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Note: XEROX automatically normalizes postgres:// or postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://xerox:xerox_secure_pass_2026@localhost:5432/xerox

# Docker Compose DB credentials
POSTGRES_USER=xerox
POSTGRES_PASSWORD=xerox_secure_pass_2026
POSTGRES_DB=xerox

# --- Redis Distributed Cache Configuration ---
# Format: redis://[[username]:[password]]@<host>:<port>/[db]
REDIS_URL=redis://localhost:6379/0

# --- Cryptographic & Authentication Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_minimum_32_byte_cryptographically_secure_random_key_here
SESSION_COOKIE_NAME=xerox_session
COOKIE_SECURE=true
COOKIE_SAMESITE=none
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Cross-Origin Resource Sharing (CORS) ---
# JSON array of origins permitted to communicate with the FastAPI backend
CORS_ORIGINS=["http://localhost:3000","https://xeroxxx69.github.io","https://ghoshankan429-sys.github.io"]

# --- Threat Intelligence & AI Model APIs ---
# Optional: Google Gemini API Key for evidence-based threat explanations
GEMINI_API_KEY=

# Optional: VirusTotal API Key for reputation intelligence
VIRUSTOTAL_API_KEY=

# --- Frontend Client Configuration ---
# Base API URL used by the React / Vite frontend
VITE_API_URL=http://localhost:8000/api/v1
